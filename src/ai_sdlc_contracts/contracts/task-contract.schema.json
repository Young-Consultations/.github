{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Young-Consultations/.github/blob/main/contracts/task-contract.schema.json",
  "title": "AI-SDLC Task Contract",
  "description": "Canonical implementation-neutral task exchanged by AI-SDLC planning and execution participants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "task_id", "source_issue", "status", "executor", "project",
    "priority", "task_type", "target_repository", "parallel_safe", "dependencies",
    "risk", "scope", "instructions", "created_by"
  ],
  "properties": {
    "contract_version": { "const": "ai-sdlc-contract/v2" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "source_issue": { "$ref": "#/$defs/issueReference" },
    "status": { "enum": ["proposed", "approved", "queued", "running", "draft-pr", "blocked", "done", "failed"] },
    "executor": { "enum": ["codex", "human", "chatgpt-planning"] },
    "project": { "type": "string", "minLength": 1, "maxLength": 128 },
    "priority": { "enum": ["p0", "p1", "p2", "p3"] },
    "task_type": { "$ref": "#/$defs/taskType" },
    "target_repository": { "$ref": "#/$defs/repository" },
    "parallel_safe": { "type": "boolean" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 256 },
      "uniqueItems": true
    },
    "risk": { "enum": ["low", "medium", "high"] },
    "scope": { "enum": ["small", "medium", "large"] },
    "instructions": { "type": "string", "minLength": 1, "maxLength": 50000 },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
    },
    "issueReference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}#[1-9][0-9]*$"
    },
    "taskType": {
      "enum": ["automation", "backlog-governance", "ci-cd", "documentation", "repository-maintenance", "feature", "bug-fix", "testing", "security"]
    }
  }
}
